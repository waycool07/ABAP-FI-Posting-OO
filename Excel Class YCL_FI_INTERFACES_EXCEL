* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method YCL_FI_INTERFACES_EXCEL->CONVERT_FILE
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RT_POSTINGDATA                 TYPE        TY_T_ALV
* | [EXC!] INPUT_DATA_ERROR
* | [EXC!] CUSTOMIZING_ERROR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_file.

* read from local
    IF NOT mr_selopt->local IS INITIAL.
      convert_file_local( RECEIVING  rt_postingdata = rt_postingdata
                          EXCEPTIONS input_data_error  = 1
                                     customizing_error = 2
                              OTHERS                   = 3 ).
      DATA(lv_subrc) = sy-subrc.
    ELSE.
* read from server
      convert_file_server( RECEIVING  rt_postingdata = rt_postingdata
                           EXCEPTIONS input_data_error  = 1
                                      customizing_error = 2
                               OTHERS                   = 3 ).
      lv_subrc = sy-subrc.
    ENDIF.

    CASE lv_subrc.
      WHEN 0.
      WHEN 1.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 RAISING input_data_error.
      WHEN 2.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                    WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 RAISING customizing_error.
      WHEN OTHERS.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 RAISING input_data_error.
    ENDCASE.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method YCL_FI_INTERFACES_EXCEL->CONVERT_FILE_LOCAL
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RT_POSTINGDATA                 TYPE        TY_T_ALV
* | [EXC!] INPUT_DATA_ERROR
* | [EXC!] CUSTOMIZING_ERROR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_file_local.

    CONSTANTS: lc_header_row TYPE kcd_ex_row_n VALUE 1.

    TYPES: BEGIN OF t_fields,
             col       TYPE kcd_ex_col_n,
             fieldname TYPE fieldname,
           END OF t_fields.

    DATA: lv_row     TYPE kcd_ex_row_n,
          lv_row_all TYPE kcd_ex_row_n,
          lv_rows    TYPE kcd_ex_row_n,
          lv_buzei   TYPE buzei.

    DATA: ls_postingdata TYPE ty_alv,
          lt_postingdata TYPE ty_t_alv,
          ls_excel       TYPE alsmex_tabline.

    DATA: lt_excel  TYPE issr_alsmex_tabline,
          lt_fields TYPE STANDARD TABLE OF t_fields.

    FIELD-SYMBOLS: <fv_field> TYPE any.
******************************************************************************

    SELECT *
      FROM tbsl WHERE bschl NE @space INTO TABLE @DATA(lt_tbsl).

    IF ms_t001 IS INITIAL.
      SELECT SINGLE *
        FROM t001 WHERE bukrs = @mr_selopt->bukrs INTO @DATA(ls_t001).
    ELSE.
      ls_t001 = ms_t001.
    ENDIF.

* Conversion into EXCEL format
    IF mt_excel[] IS INITIAL.
      LOOP AT mt_data_string INTO DATA(ls_data_string).
*        LOOP AT ls_data_string-data INTO DATA(ls_data).
          CLEAR ls_excel.
          ls_excel = CONV #( ls_data_string ).
          APPEND ls_excel TO lt_excel.
*        ENDLOOP.
      ENDLOOP.
    ELSE.
      lt_excel[] = mt_excel[].
    ENDIF.

    CHECK NOT lt_excel[] IS INITIAL.

    READ TABLE lt_excel INDEX lines( lt_excel ) INTO DATA(ls_xls).
    lv_rows = ls_xls-row.

* header fields mapping
    LOOP AT lt_excel ASSIGNING FIELD-SYMBOL(<fs_excel>)
                     WHERE row = lc_header_row.
      SHIFT <fs_excel>-value LEFT DELETING LEADING space.

      APPEND INITIAL LINE TO lt_fields ASSIGNING FIELD-SYMBOL(<fields>).
      <fields>-col       = <fs_excel>-col.
      <fields>-fieldname = <fs_excel>-value.
    ENDLOOP.

    lv_row   = lc_header_row + 1.
    lv_buzei = 1.

* mapping of universal ALV structure
    DATA(lv_total) = lines( lt_excel ).

    DO lv_rows TIMES.

      IF sy-index <= lc_header_row.
        CONTINUE.
      ENDIF.

      DATA(lv_gui_text) = |{ TEXT-001 } ({ sy-index }/{ lv_total })|.

      cl_progress_indicator=>progress_indicate( i_text = lv_gui_text i_output_immediately = 'X' ).

      CLEAR ls_postingdata.

*      ls_postingdata-interface_id = mr_selopt->interface_id.
      "ls_postingdata-kind      = 'B'.

      LOOP AT lt_fields INTO DATA(ls_fields).
        READ TABLE lt_excel INTO ls_xls WITH KEY row = lv_row
                                                 col = ls_fields-col.
        IF sy-subrc EQ 0.
          ASSIGN COMPONENT ls_fields-fieldname OF STRUCTURE ls_postingdata TO <fv_field>.
          IF sy-subrc EQ 0.
            DESCRIBE FIELD <fv_field> TYPE DATA(lv_type).
            CASE lv_type.
              WHEN 'D'.
                convert_date( EXPORTING iv_datum = CONV #( ls_xls-value )
                              IMPORTING ev_datum = <fv_field>
                              EXCEPTIONS input_data_error  = 1
                                  OTHERS                   = 2 ).
                IF sy-subrc <> 0.
                  MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 RAISING input_data_error.
                ENDIF.
              WHEN OTHERS.
                <fv_field> = ls_xls-value.
            ENDCASE.
          ENDIF.
        ENDIF.
      ENDLOOP.

* input data check
      IF  mr_selopt->bukrs NE ls_postingdata-bukrs.
        MESSAGE e008(yfi_interfaces) WITH mr_selopt->bukrs ls_postingdata-bukrs RAISING input_data_error.
      ENDIF.
      APPEND ls_postingdata TO lt_postingdata.

      lv_row   = lv_row + 1.
      lv_buzei = lv_buzei + 1.
    ENDDO.

    rt_postingdata[] = CONV #( lt_postingdata[] ).

  ENDMETHOD.


