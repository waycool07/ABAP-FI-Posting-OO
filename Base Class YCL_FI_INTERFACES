* | [<-->] CV_WRBTR                       TYPE        WRBTR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_amount_display_to_sap.

    DATA: lv_amount_in  TYPE dec11_4,
          lv_amount_out TYPE dec11_4.
***************************************************************

    lv_amount_in = CONV #( cv_wrbtr ).
    CALL FUNCTION 'CURRENCY_AMOUNT_DISPLAY_TO_SAP'
      EXPORTING
        currency        = iv_currency
        amount_display  = lv_amount_in
      IMPORTING
        amount_internal = lv_amount_out
      EXCEPTIONS
        internal_error  = 1
        OTHERS          = 2.
    IF sy-subrc <> 0.
* Implement suitable error handling here
    ELSE.
      cv_wrbtr = CONV #( lv_amount_out ).
    ENDIF.

  ENDMETHOD.


