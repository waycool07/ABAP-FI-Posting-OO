* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method YCL_FI_INTERFACES->GET_FILE_EXTENSION
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RT_FILEEXT                     TYPE        TY_T_EPS2FILNAM
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_file_extension.

    CASE mr_selopt->interface_id.
      WHEN gc_excel.
        APPEND '.XLSX' TO rt_fileext.
        APPEND '.XLS'  TO rt_fileext.
      WHEN OTHERS.
        APPEND '.CSV' TO rt_fileext.
        APPEND '.TXT' TO rt_fileext.
        APPEND '.XLSX' TO rt_fileext.
        APPEND '.XLS'  TO rt_fileext.
    ENDCASE.

  ENDMETHOD.


