* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method YCL_FI_INTERFACES->CONVERT_DATA_ALV
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [<-->] CT_DATA                        TYPE        TY_T_ALV
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_data_alv.

    TYPES: BEGIN OF t_id,
             bukrs    TYPE bukrs,
             id       TYPE char4,
           END OF t_id.

    TYPES: BEGIN OF t_t001,
             bukrs TYPE t001-bukrs,
             waers TYPE t001-waers,
           END OF t_t001.

    DATA: lv_hkont TYPE hkont,
          lv_kunnr TYPE kunnr,
          lv_lifnr TYPE lifnr,
          lv_buzei TYPE buzei,
          lv_belnr TYPE belnr_d.

    DATA: lt_id   TYPE STANDARD TABLE OF t_id,
          ls_id   TYPE t_id,
          ls_t001 TYPE t_t001.
********************************************************************************

    SELECT *
      FROM tbsl WHERE bschl NE @space INTO TABLE @DATA(lt_tbsl).

    SELECT SINGLE *
      FROM t001 WHERE bukrs EQ @iv_bukrs INTO CORRESPONDING FIELDS OF @ls_t001.


********************************************************************************
* Adding accounting document line number
    LOOP AT lt_id INTO ls_id.
      CLEAR: lv_buzei.
      LOOP AT ct_data ASSIGNING FIELD-SYMBOL(<fs_postingdata>)
                             WHERE bukrs    = ls_id-bukrs.
        ADD 1 TO lv_buzei.
        <fs_postingdata>-buzei = lv_buzei.
      ENDLOOP.
    ENDLOOP.

********************************************************************************
    DATA(lv_total) = lines( ct_data ).

    LOOP AT ct_data ASSIGNING <fs_postingdata>.

* status GUI INFO
      DATA(lv_gui_text) = |{ TEXT-001 } ({ sy-tabix }/{ lv_total })|.
      cl_progress_indicator=>progress_indicate( i_text = lv_gui_text i_output_immediately = 'X' ).

      IF NOT <fs_postingdata>-bschl IS INITIAL.
        UNPACK <fs_postingdata>-bschl TO <fs_postingdata>-bschl.
      ENDIF.

      IF NOT <fs_postingdata>-zterm IS INITIAL.
        UNPACK <fs_postingdata>-zterm TO <fs_postingdata>-zterm.
      ENDIF.

      READ TABLE lt_tbsl INTO DATA(ls_tbsl)
                         WITH KEY bschl = <fs_postingdata>-bschl.
      IF sy-subrc EQ 0.
        <fs_postingdata>-shkzg = ls_tbsl-shkzg.
      ENDIF.

      CASE <fs_postingdata>-shkzg.
        WHEN 'S'.
          <fs_postingdata>-dmbtr = abs( <fs_postingdata>-dmbtr ).
          <fs_postingdata>-wrbtr = abs( <fs_postingdata>-wrbtr ).
          <fs_postingdata>-dmbe2 = abs( <fs_postingdata>-dmbe2 ).
        WHEN 'H'.
          <fs_postingdata>-dmbtr = abs( <fs_postingdata>-dmbtr ) * ( - 1 ).
          <fs_postingdata>-wrbtr = abs( <fs_postingdata>-wrbtr ) * ( - 1 ).
          <fs_postingdata>-dmbe2 = abs( <fs_postingdata>-dmbe2 ) * ( - 1 ).
      ENDCASE.

      CLEAR: lv_kunnr, lv_lifnr, lv_hkont.

      IF NOT <fs_postingdata>-kostl IS INITIAL.
        <fs_postingdata>-kostl = |{ <fs_postingdata>-kostl ALPHA = IN }|.
      ENDIF.

      IF NOT <fs_postingdata>-prctr IS INITIAL.
        <fs_postingdata>-prctr = |{ <fs_postingdata>-prctr ALPHA = IN }|.
      ENDIF.

      IF <fs_postingdata>-bupla EQ '0'.
        UNPACK <fs_postingdata>-bupla TO <fs_postingdata>-bupla.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method YCL_FI_INTERFACES->CONVERT_DATE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DATUM                       TYPE        CHAR10
* | [<---] EV_DATUM                       TYPE        DATUM
* | [EXC!] INPUT_DATA_ERROR
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_date.

    DATA: lv_datum TYPE char10.

    lv_datum = iv_datum.

    CALL FUNCTION 'CONVERT_DATE_TO_INTERNAL'
      EXPORTING
        date_external            = lv_datum
*       ACCEPT_INITIAL_DATE      =
      IMPORTING
        date_internal            = ev_datum
      EXCEPTIONS
        date_external_is_invalid = 1
        OTHERS                   = 2.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                  WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 RAISING input_data_error.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method YCL_FI_INTERFACES->CONVERT_DATE2
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DATUM                       TYPE        CHAR10
* | [<---] EV_DATUM                       TYPE        DATUM
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD convert_date2.

    DATA(lv_datum) = iv_datum.
    REPLACE ALL OCCURRENCES OF '-' IN lv_datum WITH space.
    REPLACE ALL OCCURRENCES OF '/' IN lv_datum WITH space.
    CONDENSE lv_datum.
    ev_datum = lv_datum.

  ENDMETHOD.


